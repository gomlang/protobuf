package tests;

use ecosystem::protobuf as pb;
use std::testing;
use std::task;

fn bytes(values: Vec[u8]) -> Slice[u8] {
    values.as_slice()
}

fn schema(fields: Vec[pb::FieldSpec]) -> pb::Schema {
    testing::expect_ok(
        pb::Schema::new(Vec::from_array([pb::MessageSpec { fields }]), 0, pb::Limits::standard()),
        "schema",
    )
}

fn item(number: u32, kind: pb::Kind, rule: pb::Rule) -> pb::FieldSpec {
    pb::FieldSpec { number, kind, rule }
}

fn decode(value: pb::Schema, input: Vec[u8]) -> pb::Message {
    testing::expect_ok(value.decode(input.as_slice(), pb::Options::standard()), "decode")
}

fn i32_value(message: pb::Message, number: u32) -> i32 {
    match message.get(number) {
        Some(pb::Value::I32(value)) => value,
        _ => {
            testing::fail("expected i32");
            0
        },
    }
}

fn error_kind[T](value: Result[T, pb::Error], kind: pb::ErrorKind, offset: isize) -> () {
    match value {
        Err(error) => {
            testing::assert_eq(error.kind, kind);
            testing::assert_eq(error.offset, offset);
        },
        Ok(_) => testing::fail("expected error"),
    }
}

#[test]
fn official_wire_vectors_and_integer_extremes() -> () {
    let pairs: Vec[(u64, Vec[u8])] = Vec::from_array(
        [
            (0, Vec::from_array([0])),
            (150, Vec::from_array([150, 1])),
            (
                18446744073709551615,
                Vec::from_array([255, 255, 255, 255, 255, 255, 255, 255, 255, 1]),
            ),
        ],
    );
    for (value, expected) in pairs {
        testing::assert(pb::encode_varint(value) == expected);
        testing::assert(
            testing::expect_ok(pb::consume_varint(expected.as_slice(), true), "varint")
                == (value, expected.len()),
        );
    }
    testing::assert_eq(pb::zigzag32(-2147483648), 4294967295);
    testing::assert_eq(pb::zigzag64(-9223372036854775807 - 1), 18446744073709551615);
    testing::assert_eq(pb::unzigzag32(4294967295), -2147483648);
    testing::assert_eq(pb::unzigzag64(18446744073709551615), -9223372036854775807 - 1);
    testing::assert(pb::encode_fixed32(305419896) == Vec::from_array([120, 86, 52, 18]));
    testing::assert(
        pb::encode_fixed64(72623859790382856) == Vec::from_array([8, 7, 6, 5, 4, 3, 2, 1]),
    );
    let raw = Vec::from_array([8, 150, 1, 18, 7, 116, 101, 115, 116, 105, 110, 103]);
    let fields = testing::expect_ok(
        pb::parse_fields(raw.as_slice(), pb::Options::standard()),
        "official fields",
    );
    testing::assert(fields[0].varint() == Option::Some(150));
    testing::assert(fields[1].payload() == "testing".to_bytes());
    testing::assert(
        testing::expect_ok(pb::encode_fields(fields.as_slice(), pb::Limits::standard()), "fields")
            == raw,
    );
}

#[test]
fn malformed_varints_tags_lengths_and_absolute_offsets() -> () {
    error_kind(
        pb::consume_varint(bytes(Vec::from_array([128])), false),
        pb::ErrorKind::UnexpectedEof,
        1,
    );
    error_kind(
        pb::consume_varint(
            bytes(Vec::from_array([255, 255, 255, 255, 255, 255, 255, 255, 255, 2])),
            false,
        ),
        pb::ErrorKind::VarintOverflow,
        9,
    );
    error_kind(
        pb::consume_varint(bytes(Vec::from_array([128, 0])), true),
        pb::ErrorKind::NonCanonical,
        0,
    );
    testing::assert(
        testing::expect_ok(
            pb::consume_varint(bytes(Vec::from_array([128, 0])), false),
            "nonminimal",
        )
            == (0, 2),
    );
    for raw in Vec::from_array(
        [Vec::from_array([0]), Vec::from_array([6]), Vec::from_array([128, 128, 128, 128, 16, 0])],
    ) {
        testing::assert_err(pb::parse_fields(raw.as_slice(), pb::Options::standard()));
    }
    error_kind(
        pb::parse_fields(bytes(Vec::from_array([8, 1, 18, 2, 1])), pb::Options::standard()),
        pb::ErrorKind::UnexpectedEof,
        5,
    );
    error_kind(
        pb::parse_fields(bytes(Vec::from_array([13, 1, 2, 3])), pb::Options::standard()),
        pb::ErrorKind::UnexpectedEof,
        4,
    );
    let value = schema(Vec::from_array([item(1, pb::Kind::String, pb::Rule::Optional)]));
    error_kind(
        value.decode(bytes(Vec::from_array([10, 1, 255])), pb::Options::standard()),
        pb::ErrorKind::InvalidUtf8,
        2,
    );
}

#[test]
fn unknown_noncanonical_fields_and_groups_are_preserved_or_discarded() -> () {
    let empty = schema(Vec::new());
    let original = Vec::from_array([136, 0, 129, 0, 19, 8, 7, 27, 28, 20]);
    let message = decode(empty, original.copy());
    original[2] = 0;
    let expected = Vec::from_array([136, 0, 129, 0, 19, 8, 7, 27, 28, 20]);
    testing::assert(
        testing::expect_ok(empty.encode(message, pb::Limits::standard()), "unknown") == expected,
    );
    let raw = message.unknown_fields()[0];
    let exported = raw.encoded();
    exported[0] = 0;
    testing::assert(raw.encoded() == Vec::from_array([136, 0, 129, 0]));
    let discard = pb::Options { discard_unknown: true, ..pb::Options::standard() };
    testing::assert(
        testing::expect_ok(empty.decode(expected.as_slice(), discard), "discard").unknown_fields().is_empty(),
    );
    for invalid in Vec::from_array(
        [Vec::from_array([11]), Vec::from_array([11, 20]), Vec::from_array([12])],
    ) {
        testing::assert_err(pb::parse_fields(invalid.as_slice(), pb::Options::standard()));
    }
    let limited = pb::Options {
        limits: pb::Limits { max_depth: 1, ..pb::Limits::standard() },
        ..pb::Options::standard(),
    };
    testing::assert_err(pb::parse_fields(expected.as_slice(), limited));
    testing::assert_eq(
        testing::expect_ok(pb::skip_field(expected.as_slice(), pb::Options::standard()), "skip"),
        4,
    );
}

#[test]
fn typed_truncation_negative_varints_wrong_wire_and_presence() -> () {
    let value = schema(
        Vec::from_array(
            [
                item(1, pb::Kind::Int32, pb::Rule::Optional),
                item(2, pb::Kind::Uint32, pb::Rule::Implicit),
                item(3, pb::Kind::Bool, pb::Rule::Implicit),
                item(4, pb::Kind::Double, pb::Rule::Implicit),
            ],
        ),
    );
    let message = decode(
        value,
        Vec::from_array([8, 255, 255, 255, 255, 15, 16, 128, 128, 128, 128, 16, 24, 255, 1]),
    );
    testing::assert_eq(i32_value(message, 1), -1);
    testing::assert(!message.has(2));
    testing::assert(
        testing::expect_ok(value.encode(message, pb::Limits::standard()), "encode negative")
            == Vec::from_array([8, 255, 255, 255, 255, 255, 255, 255, 255, 255, 1, 24, 1]),
    );
    let zero = decode(value, Vec::from_array([8, 0]));
    testing::assert(zero.has(1));
    zero.set(4, pb::Value::F64(float64_from_bits(9223372036854775808)));
    testing::assert(
        decode(
            value,
            testing::expect_ok(value.encode(zero, pb::Limits::standard()), "negative zero"),
        ).has(4),
    );
    let wrong = decode(value, Vec::from_array([13, 1, 0, 0, 0]));
    testing::assert(!wrong.has(1));
    testing::assert_eq(wrong.unknown_fields().len(), 1);
}

#[test]
fn packed_segments_mix_with_unpacked_and_empty_segments_charge_fields() -> () {
    let value = schema(Vec::from_array([item(1, pb::Kind::Int32, pb::Rule::Packed)]));
    let message = decode(value, Vec::from_array([10, 2, 1, 2, 8, 3, 10, 0, 10, 1, 4]));
    testing::assert_eq(message.get_all(1).len(), 4);
    testing::assert(
        testing::expect_ok(value.encode(message, pb::Limits::standard()), "packed")
            == Vec::from_array([10, 4, 1, 2, 3, 4]),
    );
    let empty = Vec::from_array([10, 0]);
    let allowed = pb::Options {
        limits: pb::Limits { max_fields: 1, max_values: 0, ..pb::Limits::standard() },
        ..pb::Options::standard(),
    };
    testing::assert_ok(value.decode(empty.as_slice(), allowed));
    let denied = pb::Options {
        limits: pb::Limits { max_fields: 0, max_values: 0, ..pb::Limits::standard() },
        ..pb::Options::standard(),
    };
    error_kind(value.decode(empty.as_slice(), denied), pb::ErrorKind::Limit, 0);
    let limited = pb::Options {
        limits: pb::Limits { max_values: 3, ..pb::Limits::standard() },
        ..pb::Options::standard(),
    };
    testing::assert_err(value.decode(bytes(Vec::from_array([10, 4, 1, 2, 3, 4])), limited));
    let fixed = schema(Vec::from_array([item(1, pb::Kind::Fixed32, pb::Rule::Repeated)]));
    error_kind(
        fixed.decode(bytes(Vec::from_array([10, 3, 0, 0, 0])), pb::Options::standard()),
        pb::ErrorKind::UnexpectedEof,
        5,
    );
}

#[test]
fn duplicate_submessages_merge_before_required_validation() -> () {
    let value = testing::expect_ok(
        pb::Schema::new(
            Vec::from_array(
                [
                    pb::MessageSpec {
                        fields: Vec::from_array([item(1, pb::Kind::Message(1), pb::Rule::Optional)]),
                    },
                    pb::MessageSpec {
                        fields: Vec::from_array(
                            [
                                item(1, pb::Kind::Int32, pb::Rule::Required),
                                item(2, pb::Kind::Int32, pb::Rule::Required),
                                item(3, pb::Kind::Int32, pb::Rule::Repeated),
                            ],
                        ),
                    },
                ],
            ),
            0,
            pb::Limits::standard(),
        ),
        "nested schema",
    );
    let message = decode(value, Vec::from_array([10, 4, 8, 1, 24, 3, 10, 4, 16, 2, 24, 4]));
    match message.get(1) {
        Some(pb::Value::Message(child)) => {
            testing::assert_eq(i32_value(child, 1), 1);
            testing::assert_eq(i32_value(child, 2), 2);
            testing::assert_eq(child.get_all(3).len(), 2);
        },
        _ => testing::fail("nested"),
    }
    error_kind(
        value.decode(bytes(Vec::from_array([10, 2, 8, 1])), pb::Options::standard()),
        pb::ErrorKind::MissingRequired,
        0,
    );
    testing::assert_ok(value.encode(message, pb::Limits::standard()));
}

#[test]
fn independent_decode_storage_schema_snapshots_and_output_ownership() -> () {
    let specs = Vec::from_array([item(1, pb::Kind::Bytes, pb::Rule::Optional)]);
    let value = schema(specs);
    specs[0] = item(1, pb::Kind::Int32, pb::Rule::Required);
    let input = Vec::from_array([10, 2, 7, 8]);
    let a = decode(value, input);
    let b = decode(value, input);
    input[2] = 99;
    match (a.get(1), b.get(1)) {
        (Some(pb::Value::Bytes(x)), Some(pb::Value::Bytes(y))) => {
            testing::assert(x == Vec::from_array([7, 8]));
            testing::assert(y == x);
            x[0] = 55;
            testing::assert_eq(y[0], 7);
            let output = testing::expect_ok(value.encode(b, pb::Limits::standard()), "owned output");
            output[2] = 66;
            testing::assert_eq(y[0], 7);
        },
        _ => testing::fail("bytes"),
    }
}

#[test]
fn budgets_reject_before_output_allocation_and_bound_cycles() -> () {
    let value = schema(
        Vec::from_array(
            [
                item(1, pb::Kind::Message(0), pb::Rule::Optional),
                item(2, pb::Kind::Bytes, pb::Rule::Optional),
            ],
        ),
    );
    let message = pb::Message::new();
    message.set(2, pb::Value::Bytes(Vec::from_array([1, 2, 3])));
    for limits in Vec::from_array(
        [
            pb::Limits { max_output: 4, ..pb::Limits::standard() },
            pb::Limits { max_values: 0, ..pb::Limits::standard() },
            pb::Limits { max_fields: 0, ..pb::Limits::standard() },
            pb::Limits { max_blob: 2, ..pb::Limits::standard() },
        ],
    ) {
        testing::assert_err(value.encode(message, limits));
    }
    let exact = pb::Limits {
        max_output: 5,
        max_blob: 3,
        max_fields: 1,
        max_values: 1,
        ..pb::Limits::standard(),
    };
    testing::assert_eq(testing::expect_ok(value.encode(message, exact), "exact budget").len(), 5);
    message.set(1, pb::Value::Message(message));
    testing::assert_err(
        value.encode(message, pb::Limits { max_depth: 3, ..pb::Limits::standard() }),
    );
    let valid = Vec::from_array([18, 3, 1, 2, 3]);
    testing::assert_err(
        value.decode(
            valid.as_slice(),
            pb::Options {
                limits: pb::Limits { max_input: 4, ..pb::Limits::standard() },
                ..pb::Options::standard(),
            },
        ),
    );
    testing::assert_err(
        value.encode(pb::Message::new(), pb::Limits { max_depth: 257, ..pb::Limits::standard() }),
    );
    testing::assert_err(
        pb::field(
            1,
            pb::WireValue::Bytes(Vec::from_array([1, 2, 3])),
            pb::Limits { max_fields: 0, ..pb::Limits::standard() },
        ),
    );
}

#[test]
fn schema_rejects_ambiguous_definitions_and_reserved_numbers() -> () {
    for fields in Vec::from_array(
        [
            Vec::from_array(
                [
                    item(1, pb::Kind::Int32, pb::Rule::Optional),
                    item(1, pb::Kind::Int64, pb::Rule::Optional),
                ],
            ),
            Vec::from_array([item(19000, pb::Kind::Int32, pb::Rule::Optional)]),
            Vec::from_array([item(1, pb::Kind::String, pb::Rule::Packed)]),
            Vec::from_array([item(1, pb::Kind::Message(1), pb::Rule::Optional)]),
            Vec::from_array([item(1, pb::Kind::Message(0), pb::Rule::Implicit)]),
        ],
    ) {
        testing::assert_err(
            pb::Schema::new(
                Vec::from_array([pb::MessageSpec { fields }]),
                0,
                pb::Limits::standard(),
            ),
        );
    }
    testing::assert_ok(pb::field(19000, pb::WireValue::Varint(1), pb::Limits::standard()));
    let value = schema(Vec::from_array([item(1, pb::Kind::Int32, pb::Rule::Optional)]));
    let message = pb::Message::new();
    message.set(1, pb::Value::U32(7));
    testing::assert_err(value.encode(message, pb::Limits::standard()));
    message.set(1, pb::Value::I32(1));
    message.add(1, pb::Value::I32(2));
    testing::assert_err(value.encode(message, pb::Limits::standard()));
}

#[test]
fn immutable_schema_and_raw_fields_support_parallel_independent_messages() -> () {
    let value = schema(Vec::from_array([item(1, pb::Kind::Bytes, pb::Rule::Optional)]));
    let raw = testing::expect_ok(
        pb::field(100, pb::WireValue::Varint(9), pb::Limits::standard()),
        "raw",
    );
    task::scope(
        |scope| {
            let jobs: Vec[task::Task[bool]] = Vec::new();
            for worker in 0..8 {
                jobs.push(
                    scope.spawn(
                        |_| {
                            for _ in 0..20 {
                                let message = decode(value, Vec::from_array([10, 2, 7, 8]));
                                if let Some(pb::Value::Bytes(payload)) = message.get(1) {
                                    payload[0] = worker.to_u8();
                                }
                                message.add_unknown(raw);
                                let output = testing::expect_ok(
                                    value.encode(message, pb::Limits::standard()),
                                    "parallel encode",
                                );
                                if output[2] != worker.to_u8() {
                                    return false
                                }
                                let exported = raw.encoded();
                                exported[0] = 0;
                                if raw.encoded()[0] == 0 {
                                    return false
                                }
                            }
                            true
                        },
                    ),
                );
            }
            for job in jobs {
                testing::assert(job.join());
            }
        },
    );
}

#[test]
fn public_primitives_leave_trailing_bytes_and_length_limits_precede_truncation() -> () {
    let number: u64 = 18446744073709551615;
    let fixed = pb::encode_fixed64(number);
    fixed.push(42);
    testing::assert(
        testing::expect_ok(pb::consume_fixed64(fixed.as_slice()), "fixed64") == (number, 8),
    );
    testing::assert(
        testing::expect_ok(
            pb::consume_fixed32(bytes(Vec::from_array([255, 255, 255, 255, 42]))),
            "fixed32",
        )
            == (4294967295, 4),
    );
    let tag = testing::expect_ok(pb::encode_tag(536870911, pb::WireType::Fixed32), "tag");
    testing::assert(
        testing::expect_ok(pb::consume_tag(tag.as_slice(), true), "consume tag")
            == (536870911, pb::WireType::Fixed32, 5),
    );
    let input = Vec::from_array([2, 0, 255, 42]);
    let (payload, used) = testing::expect_ok(
        pb::consume_bytes(input.as_slice(), pb::Options::standard()),
        "consume bytes",
    );
    testing::assert_eq(used, 3);
    input[1] = 7;
    testing::assert(payload == Vec::from_array([0, 255]));
    let exact = pb::Limits { max_blob: 2, max_output: 3, ..pb::Limits::standard() };
    testing::assert(
        testing::expect_ok(pb::encode_bytes(payload.as_slice(), exact), "encode bytes")
            == Vec::from_array([2, 0, 255]),
    );
    testing::assert_err(pb::encode_bytes(payload.as_slice(), pb::Limits { max_output: 2, ..exact }));
    error_kind(
        pb::consume_bytes(
            bytes(Vec::from_array([3])),
            pb::Options { limits: exact, ..pb::Options::standard() },
        ),
        pb::ErrorKind::Limit,
        0,
    );
    error_kind(
        pb::consume_bytes(
            bytes(Vec::from_array([2])),
            pb::Options { limits: exact, ..pb::Options::standard() },
        ),
        pb::ErrorKind::UnexpectedEof,
        1,
    );
    error_kind(
        pb::consume_bytes(
            bytes(Vec::from_array([128, 0])),
            pb::Options { canonical_varints: true, ..pb::Options::standard() },
        ),
        pb::ErrorKind::NonCanonical,
        0,
    );
}

#[test]
fn group_constructor_has_exact_record_depth_and_output_bounds() -> () {
    let child = testing::expect_ok(
        pb::field(1, pb::WireValue::Varint(150), pb::Limits::standard()),
        "child",
    );
    let children = Vec::from_array([child]);
    let exact = pb::Limits {
        max_output: 5,
        max_fields: 3,
        max_values: 1,
        max_depth: 1,
        ..pb::Limits::standard(),
    };
    let group = testing::expect_ok(pb::field(2, pb::WireValue::Group(children), exact), "group");
    children.clear();
    testing::assert(group.encoded() == Vec::from_array([19, 8, 150, 1, 20]));
    testing::assert(group.payload() == child.encoded());
    let exported = group.payload();
    exported[0] = 0;
    testing::assert(group.payload() == child.encoded());
    let raw = Vec::from_array([group]);
    testing::assert(
        testing::expect_ok(pb::encode_fields(raw.as_slice(), exact), "group output")
            == group.encoded(),
    );
    for limits in Vec::from_array(
        [
            pb::Limits { max_fields: 2, ..exact },
            pb::Limits { max_output: 4, ..exact },
            pb::Limits { max_depth: 0, ..exact },
            pb::Limits { max_values: 0, ..exact },
        ],
    ) {
        testing::assert_err(pb::field(2, pb::WireValue::Group(Vec::from_array([child])), limits));
        testing::assert_err(pb::encode_fields(raw.as_slice(), limits));
    }
    testing::assert_eq(
        testing::expect_ok(
            pb::skip_field(
                group.encoded().as_slice(),
                pb::Options {
                    limits: pb::Limits { max_values: 0, ..exact },
                    ..pb::Options::standard(),
                },
            ),
            "skip without materialization",
        ),
        5,
    );
}

#[test]
fn nested_and_packed_errors_retain_absolute_input_offsets() -> () {
    let value = testing::expect_ok(
        pb::Schema::new(
            Vec::from_array(
                [
                    pb::MessageSpec {
                        fields: Vec::from_array([item(1, pb::Kind::Message(1), pb::Rule::Optional)]),
                    },
                    pb::MessageSpec {
                        fields: Vec::from_array(
                            [
                                item(1, pb::Kind::String, pb::Rule::Optional),
                                item(2, pb::Kind::Int32, pb::Rule::Packed),
                            ],
                        ),
                    },
                ],
            ),
            0,
            pb::Limits::standard(),
        ),
        "nested schema",
    );
    error_kind(
        value.decode(bytes(Vec::from_array([24, 1, 10, 3, 10, 1, 255])), pb::Options::standard()),
        pb::ErrorKind::InvalidUtf8,
        6,
    );
    error_kind(
        value.decode(bytes(Vec::from_array([24, 1, 10, 3, 18, 1, 128])), pb::Options::standard()),
        pb::ErrorKind::UnexpectedEof,
        7,
    );
    let exact = pb::Options {
        limits: pb::Limits { max_depth: 1, max_fields: 2, max_values: 2, ..pb::Limits::standard() },
        ..pb::Options::standard(),
    };
    testing::assert_ok(value.decode(bytes(Vec::from_array([10, 3, 10, 1, 97])), exact));
    error_kind(
        value.decode(
            bytes(Vec::from_array([10, 0])),
            pb::Options {
                limits: pb::Limits { max_depth: 0, ..pb::Limits::standard() },
                ..pb::Options::standard(),
            },
        ),
        pb::ErrorKind::Limit,
        2,
    );
}
